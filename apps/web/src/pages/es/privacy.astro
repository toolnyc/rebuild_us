---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/sections/Footer.astro";
import RichText from "../../components/RichText.astro";
import { sanityClient } from "../../lib/sanity";
import generatedJson from "../../i18n/tables/es.generated.json";
import overridesJson from "../../i18n/tables/es.overrides.json";
import { validateTable } from "../../i18n/contract";
import { localizedContent } from "../../i18n/view";

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
const privacyPage = await sanityClient.fetch(`*[_type == "privacyPage"][0]`);
const visibility = await sanityClient.fetch(`{ "privacyPage": *[_type == "privacyPage"][0].visible }`);
const localized = localizedContent({ siteSettings, privacyPage }, validateTable(generatedJson), validateTable(overridesJson));
const site = localized.siteSettings;
const page = localized.privacyPage;
const hasPage = localized.included.has("privacyPage");
---

<BaseLayout locale="es" title={hasPage ? `${page.title} — Rebuild` : "Rebuild"} canonicalUrl="https://rebuild.us/es/privacy" alternateUrl="https://rebuild.us/privacy">
  <div class="w-full h-[28px] bg-accent-sage"></div>
  {localized.included.has("site") && <div class="sticky top-0 z-50"><Nav locale="es" route="/privacy" joinDestination={site.joinDestination as string} labels={{ resources: site.navResources as string, join: site.navJoin as string }} /></div>}
  {hasPage && <main class="mx-auto max-w-3xl px-6 py-20"><h1 class="ty-h1">{page.title as string}</h1><div class="prose mt-8 text-ink [&_p]:mt-4"><RichText value={page.body as never} /></div></main>}
  {localized.included.has("site") && <Footer locale="es" route="/privacy" visibility={visibility} labels={{ privacy: site.footerPrivacy as string, copyright: site.footerCopyright as string }} />}
</BaseLayout>
