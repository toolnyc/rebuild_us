---
import SharePdfPage from "../../../components/SharePdfPage.astro";
import { fetchSharePages, hasSpanish, sharePageUrl, sharePageUrlEs, type SharePage } from "../../../lib/sharePages";

export async function getStaticPaths() {
  const pages = await fetchSharePages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: page }));
}

const page = Astro.props as SharePage;
---

<SharePdfPage
  title={page.titleEs || page.title}
  fileUrl={page.fileUrlEs || page.fileUrl}
  canonicalUrl={sharePageUrlEs(page.slug)}
  alternateUrl={hasSpanish(page) ? sharePageUrl(page.slug) : undefined}
  lang="es"
/>
