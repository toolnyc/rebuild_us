---
import SharePdfPage from "../../../components/SharePdfPage.astro";
import { sanityClient } from "../../../lib/sanity";

export async function getStaticPaths() {
  const pages = await sanityClient.fetch(
    `*[_type == "sharePage" && defined(slug.current) && defined(file.asset)]{
      "slug": slug.current,
      title,
      titleEs,
      "fileUrl": file.asset->url,
      "fileUrlEs": fileEs.asset->url
    }`,
  );
  return pages.map((page: any) => ({
    params: { slug: page.slug },
    props: page,
  }));
}

const page = Astro.props;
const canonicalUrl = `https://www.rebuild.us/es/share/${page.slug}`;
---

<SharePdfPage
  title={page.titleEs ?? page.title}
  fileUrl={page.fileUrlEs ?? page.fileUrl}
  canonicalUrl={canonicalUrl}
  alternateUrl={`https://www.rebuild.us/share/${page.slug}`}
  lang="es"
/>
