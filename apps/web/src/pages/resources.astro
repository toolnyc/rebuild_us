---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import TornEdge from "../components/TornEdge.astro";
import WrittenGuides from "../components/sections/WrittenGuides.astro";
import VideoLibrary from "../components/sections/VideoLibrary.astro";
import GetInvolved from "../components/sections/GetInvolved.astro";
import Footer from "../components/sections/Footer.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import { sanityClient } from "../lib/sanity";

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);

const page = await sanityClient.fetch(`*[_type == "resourcesPage"][0]`);

const guides = await sanityClient.fetch(
  `*[_type == "resourceGuide"]{ _id, title, section, "fileUrl": file.asset->url, order } | order(order asc)`,
);

const videos = await sanityClient.fetch(
  `*[_type == "resourceVideo"]{ _id, title, youtubeUrl, order } | order(order asc)`,
);

const visibility = await sanityClient.fetch(`{
  "privacyPage": *[_type == "privacyPage"][0].visible,
  "resourcesPage": *[_type == "resourcesPage"][0].visible,
  "aboutPage": *[_type == "aboutPage"][0].visible,
  "contactPage": *[_type == "contactPage"][0].visible,
  "caseStudiesPage": *[_type == "caseStudiesPage"][0].visible,
  "memberPortalPage": *[_type == "memberPortalPage"][0].visible
}`);

const joinDestination = siteSettings?.joinDestination ?? "#join";
---

<BaseLayout title={`${page?.title ?? "Resources"} — Rebuild`} canonicalUrl="https://rebuild.us/resources" alternateUrl="https://rebuild.us/es/resources">
  <!-- Sage top strip -->
  <div class="w-full h-[28px] bg-accent-sage"></div>

  <div class="sticky top-0 z-50">
    <Nav
      showGive={siteSettings?.showGive}
      joinDestination={joinDestination}
      resourcesDestination={siteSettings?.resourcesDestination}
    />
  </div>

  <main class="relative">
    <!-- Orange edge bars full page height (desktop only) -->
    <div class="hidden lg:block fixed top-0 right-0 w-[22px] bg-accent-orange h-full z-0 pointer-events-none" aria-hidden="true"></div>
    <!-- Left bar: orange for first half, sage for remainder — approximate via gradient -->
    <div
      class="hidden lg:block fixed top-0 left-0 w-[22px] h-full z-0 pointer-events-none"
      style="background: linear-gradient(to bottom, var(--color-accent-orange) 50%, var(--color-accent-sage) 50%);"
      aria-hidden="true"
    ></div>

    <!-- Hero yellow band -->
    <div class="relative">
      <section class="bg-accent-yellow px-6 pt-20 pb-0 lg:pt-28">
        <div class="mx-auto max-w-7xl" data-animate="hero">
          <h1 class="ty-display">{page?.heroHeadline ?? "Resources"}</h1>
          {
            page?.heroSubcopy && (
              <p class="mt-6 max-w-2xl ty-lead">
                {page.heroSubcopy}
              </p>
            )
          }
        </div>
      </section>
      <!-- Torn bottom edge of yellow band -->
      <TornEdge position="bottom" color="var(--color-accent-yellow)" />
    </div>

    <WrittenGuides guides={guides} />

    <VideoLibrary heading={page?.videoLibraryHeading} videos={videos} />

    <GetInvolved
      copy={page?.newsletterCopy}
      finePrint={page?.newsletterFinePrint}
      formSrc={siteSettings?.getInvolvedFormSrc}
      instagramUrl={siteSettings?.instagramUrl}
      facebookUrl={siteSettings?.facebookUrl}
      youtubeUrl={siteSettings?.youtubeUrl}
    />
  </main>

  <Footer
    joinDestination={joinDestination}
    showGive={siteSettings?.showGive}
    visibility={visibility}
    route="/resources"
  />
  <SmoothScroll />
</BaseLayout>

<script>
  import { setupMotion } from "../scripts/motion";

  setupMotion({ page: "resources" });
</script>
