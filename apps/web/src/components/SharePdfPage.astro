---
interface Props {
  title: string;
  fileUrl: string;
  canonicalUrl: string;
  alternateUrl?: string;
  lang?: "en" | "es";
}

const { title, fileUrl, canonicalUrl, alternateUrl, lang = "en" } = Astro.props;
const downloadLabel = lang === "es" ? "Descargar PDF" : "Download PDF";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Rebuild</title>
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alternateUrl} />
          <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        </>
      )
    }
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
      }
      .pdf-frame {
        display: block;
        width: 100%;
        height: 100dvh;
        border: 0;
      }
      .fallback {
        display: grid;
        place-items: center;
        height: 100dvh;
        font-family: system-ui, sans-serif;
      }
    </style>
  </head>
  <body>
    <!-- <object> (not <iframe>) so the fallback actually renders when the browser
         can't display PDFs inline, e.g. Android Chrome. -->
    <object class="pdf-frame" data={`${fileUrl}#view=FitH`} type="application/pdf" title={title}>
      <div class="fallback">
        <a href={fileUrl}>{downloadLabel}</a>
      </div>
    </object>
  </body>
</html>
