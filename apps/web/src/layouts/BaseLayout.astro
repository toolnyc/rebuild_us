---
import '../styles/global.css';
import utmPersistence from '../scripts/utm-persistence.js?raw';
import stEmbedUtm from '../scripts/st-embed-utm.js?raw';

interface Props {
  title?: string;
  locale?: "en" | "es";
  canonicalUrl?: string;
  alternateUrl?: string;
}

const {
  title = 'Rebuild — The National Disaster Survivors Association',
  locale = "en",
  canonicalUrl = Astro.url.href,
  alternateUrl,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && <link rel="alternate" hreflang={locale === "en" ? "es" : "en"} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={locale} href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- UTM persistence: must run before the Solidarity Tech embed script so restored UTMs are visible to it. Keep parser-blocking (is:inline), never async/defer. -->
    <script is:inline set:html={utmPersistence}></script>
    <!-- UTM delivery: sends st:embed:context to ST iframes directly, so attribution does not depend on v1.js catching the iframe load event. Also parser-blocking, after persistence. -->
    <script is:inline set:html={stEmbedUtm}></script>
    <script src="https://act.rebuild.us/embed/v1.js" async></script>
    <!-- Fundraise Up -->
    <script>(function(w,d,s,n,a){if(!w[n]){var l='call,catch,on,once,set,then,track,openCheckout'
.split(','),i,o=function(n){return'function'==typeof n?o.l.push([arguments])&&o
:function(){return o.l.push([n,arguments])&&o}},t=d.getElementsByTagName(s)[0],
j=d.createElement(s);j.async=!0;j.src='https://cdn.fundraiseup.com/widget/'+a+'';
t.parentNode.insertBefore(j,t);o.s=Date.now();o.v=5;o.h=w.location.href;o.l=[];
for(i=0;i<8;i++)o[l[i]]=o(l[i]);w[n]=o}
})(window,document,'script','FundraiseUp','AEFYDEJU');</script>
    <!-- End Fundraise Up -->
  </head>
  <body>
    <slot />
  </body>
</html>
